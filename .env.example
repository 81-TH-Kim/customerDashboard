# 실제 값은 .env 로 복사해서 채우세요. .env / secrets/ 는 절대 커밋하지 마세요.

# ─────────────────────────────────────────────────────────────
# 방식 1) Gmail IMAP + 앱 비밀번호  (권장 · OAuth 등록 불필요)
#   Google 계정 → 보안 → 2단계 인증 ON → '앱 비밀번호' 16자리 생성
# ─────────────────────────────────────────────────────────────
GMAIL_ADDRESS=doyourself81@gmail.com
GMAIL_APP_PASSWORD=

# ─────────────────────────────────────────────────────────────
# 방식 2) Gmail API + OAuth  (Google Cloud Console 등록 필요)
# ─────────────────────────────────────────────────────────────
GMAIL_CREDENTIALS_FILE=secrets/credentials.json
GMAIL_TOKEN_FILE=secrets/token.json
GMAIL_USER=me
